{
  // JC ROYAL — admin console host. Deploy after `pnpm --filter @jc/admin build`.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jc-royal-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "services": [{ "binding": "API", "service": "jc-royal-api" }],
  "env": {
    "production": {
      "name": "jc-royal-admin-prod",
      "services": [{ "binding": "API", "service": "jc-royal-api-prod" }]
    }
  }
}
