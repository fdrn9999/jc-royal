{
  // JC ROYAL — HTTP API, auth, static user site, WebSocket entry.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jc-royal-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jc-royal-db",
      // Replace with the id printed by `wrangler d1 create jc-royal-db` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TABLES", "class_name": "TableRoom", "script_name": "jc-royal-game" }]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174,http://localhost:8787,http://127.0.0.1:8787",
    "ADMIN_ORIGIN": "http://localhost:5174",
    "APP_ORIGIN": "http://localhost:5173",
    "PBKDF2_ITERATIONS": "100000",
    "SIGNUP_GRANT": "10000"
  },
  "observability": { "enabled": true },
  // Daily housekeeping (src/lib/housekeeping.ts) at 18:30 UTC = 03:30 KST. Inherited by env.production.
  // Local dev never fires it on its own: GET /cdn-cgi/local/scheduled runs it once.
  "triggers": { "crons": ["30 18 * * *"] },
  "env": {
    "production": {
      // Served at https://play.jcroyal.workers.dev (account workers.dev subdomain: jcroyal).
      "name": "play",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "jc-royal-db-prod",
          "database_id": "ea0b162f-0186-4312-a4ea-10f579e298f0",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "TABLES", "class_name": "TableRoom", "script_name": "jc-royal-game-prod" }]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://play.jcroyal.workers.dev,https://admin.jcroyal.workers.dev",
        "ADMIN_ORIGIN": "https://admin.jcroyal.workers.dev",
        "APP_ORIGIN": "https://play.jcroyal.workers.dev",
        // Password reset mail turns on once MAIL_FROM is set to an address on a
        // domain verified in Resend (and the RESEND_API_KEY secret exists).
        "PBKDF2_ITERATIONS": "100000",
        "SIGNUP_GRANT": "10000"
      }
    }
  }
}
