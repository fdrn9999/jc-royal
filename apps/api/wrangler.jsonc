{
  // JC ROYAL — HTTP API, auth, static user site, WebSocket entry.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jc-royal-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jc-royal-db",
      // Replace with the id printed by `wrangler d1 create jc-royal-db` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TABLES", "class_name": "TableRoom", "script_name": "jc-royal-game" }]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174,http://localhost:8787,http://127.0.0.1:8787",
    "ADMIN_ORIGIN": "http://localhost:5174",
    "WEBAUTHN_RP_ID": "localhost",
    "PBKDF2_ITERATIONS": "100000",
    "SIGNUP_GRANT": "10000"
  },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "jc-royal-api-prod",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "jc-royal-db-prod",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "TABLES", "class_name": "TableRoom", "script_name": "jc-royal-game-prod" }]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://jcroyal.example,https://admin.jcroyal.example",
        "ADMIN_ORIGIN": "https://admin.jcroyal.example",
        "WEBAUTHN_RP_ID": "admin.jcroyal.example",
        "PBKDF2_ITERATIONS": "100000",
        "SIGNUP_GRANT": "10000"
      }
    }
  }
}
