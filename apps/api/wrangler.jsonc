{
  // JC ROYAL — HTTP API, auth, static user site, WebSocket entry.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jc-royal-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The shareable pages go through the worker for their link previews (src/lib/og.ts); the rest is served as is.
    "run_worker_first": ["/api/*", "/ws/*", "/", "/register", "/table/*", "/board/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jc-royal-db",
      // Replace with the id printed by `wrangler d1 create jc-royal-db` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TABLES", "class_name": "TableRoom", "script_name": "jc-royal-game" },
      { "name": "PRESENCE", "class_name": "PresenceHub", "script_name": "jc-royal-game" },
      { "name": "REALTIME", "class_name": "RealtimeHub", "script_name": "jc-royal-game" },
      { "name": "ADMIN_MONITOR", "class_name": "AdminMonitorHub", "script_name": "jc-royal-game" }
    ]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174,http://localhost:8787,http://127.0.0.1:8787",
    "ADMIN_ORIGIN": "http://localhost:5174",
    "APP_ORIGIN": "http://localhost:5173",
    "PBKDF2_ITERATIONS": "100000",
    "SIGNUP_GRANT": "10000",
    // Web Push: the contact the push services see. The key pair is two secrets (docs/DEPLOYMENT.md "웹 푸시 키").
    "VAPID_SUBJECT": "https://jc-royal.site"
  },
  "observability": { "enabled": true },
  // Daily housekeeping (src/lib/housekeeping.ts) at 18:30 UTC = 03:30 KST, and every minute the push outbox's retries
  // and the events the game worker queued (src/lib/notify.ts; it returns at once without the VAPID keys). Inherited by
  // env.production. Local dev never fires them on its own: GET /cdn-cgi/local/scheduled?cron=... runs one once.
  "triggers": { "crons": ["30 18 * * *", "* * * * *"] },
  "env": {
    "production": {
      // Served at https://jc-royal.site, a custom domain attached in the Cloudflare dashboard. No "routes" here on
      // purpose: wrangler then leaves the dashboard's domains alone and keeps https://play.jcroyal.workers.dev
      // (account workers.dev subdomain: jcroyal) for previews (docs/DEPLOYMENT.md section 4).
      "name": "play",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "jc-royal-db-prod",
          "database_id": "ea0b162f-0186-4312-a4ea-10f579e298f0",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "TABLES", "class_name": "TableRoom", "script_name": "jc-royal-game-prod" },
          { "name": "PRESENCE", "class_name": "PresenceHub", "script_name": "jc-royal-game-prod" },
          { "name": "REALTIME", "class_name": "RealtimeHub", "script_name": "jc-royal-game-prod" },
          { "name": "ADMIN_MONITOR", "class_name": "AdminMonitorHub", "script_name": "jc-royal-game-prod" }
        ]
      },
      "vars": {
        "ENVIRONMENT": "production",
        // Requests from the page's own address are always accepted (lib/http.ts csrfGuard, routes/tables.ts), so the
        // workers.dev preview of the player site still works without being listed here.
        "ALLOWED_ORIGINS": "https://jc-royal.site,https://admin.jc-royal.site",
        // A single address: the admin console signs in only at https://admin.jc-royal.site.
        "ADMIN_ORIGIN": "https://admin.jc-royal.site",
        // Links in mail (sign-up code, password reset) and in the admin console point here.
        "APP_ORIGIN": "https://jc-royal.site",
        // jc-royal.site is verified in Resend. With the RESEND_API_KEY secret this turns mail on, and sign-up then
        // requires the emailed code (routes/auth.ts emailVerificationOn).
        "MAIL_FROM": "JC ROYAL <noreply@jc-royal.site>",
        "PBKDF2_ITERATIONS": "100000",
        "SIGNUP_GRANT": "10000",
        "VAPID_SUBJECT": "https://jc-royal.site"
      }
    }
  }
}
